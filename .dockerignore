# .dockerignore

# Build artifacts
**/bin/
**/obj/
**/out/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Test results
TestResults/
[Tt]est[Rr]esult*/

# Python cache
__pycache__/
*.pyc

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/

# Documentation
*.md
!README.md

# Don't exclude the word data files as they might be needed
# word-data/
# python/

# Logs
*.log
